# Backend
CC_API_HOST=0.0.0.0
CC_API_PORT=8000
CC_API_LOG_LEVEL=INFO
CC_API_ENV=dev
# CORS — origines navigateur autorisées (fetch credentials:include). Vide = CORS
# désactivé → les appels navigateur→API échouent en cross-origin (auth, chat,
# adhésion). En dev, lister les origines du front. En prod, l'origine publique.
CC_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=class_consciousness
POSTGRES_USER=cc
POSTGRES_PASSWORD=changeme

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (Anthropic Claude) — génération RAG + juge d'ancrage
ANTHROPIC_API_KEY=
# DEV LOCAL uniquement : token OAuth d'un abonnement Claude Code (`claude setup-token`),
# utilisé en `Authorization: Bearer` à la place de la clé API. Prioritaire sur
# ANTHROPIC_API_KEY s'il est défini → permet de bosser le RAG sans consommer la clé.
# Laisser VIDE en prod (un backend de prod doit tourner sur une vraie clé API).
ANTHROPIC_AUTH_TOKEN=
# Modèle de génération de la dissertation (défaut settings.py : claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Modèle du 2ᵉ passage « juge » d'entailment — Haiku 4.5 : rapide, suffisant
# pour la classification ENTAILED / NOT_ENTAILED / CONTRADICTED.
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5

# Embeddings + reranking — serveur cc-embed (Qwen3 0.6B sur CPU, apps/embed-server).
# En prod, cc-embed est un service du compose, joint via http://cc-embed:8001.
CC_API_EMBED_SERVER_URL=http://127.0.0.1:8001
CC_API_EMBED_DIM=1024
CC_API_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# Stripe — paiement de la cotisation associative (clés sk_test_… en dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Pay-as-you-go : Price metered (price_… adossé à un Billing Meter) + nom de
# l'évènement de meter. Les deux sont créés par ops/scripts/provision-stripe-payg.py.
STRIPE_PRICE_PAYG=
STRIPE_METER_EVENT_NAME=rag_tokens

# Authentification — email + mot de passe (Argon2), session par cookie signé,
# vérification d'e-mail obligatoire.
# CC_API_SESSION_SECRET : signe le cookie de session — OBLIGATOIRE en prod.
CC_API_SESSION_SECRET=dev-insecure-session-secret
# SMTP — envoi des e-mails (lien de vérification d'adresse, réinitialisation de
# mot de passe). Laisser CC_API_SMTP_HOST vide en dev : le lien est alors
# journalisé (devLink) au lieu d'être expédié.
CC_API_SMTP_HOST=
CC_API_SMTP_PORT=587
CC_API_SMTP_USER=
CC_API_SMTP_PASSWORD=
CC_API_SMTP_FROM=noreply@consciencedeclasse.com
CC_API_SMTP_STARTTLS=true

# Quota *gratuit* de l'assistant RAG — fenêtre glissante (lecture du corpus
# toujours libre). Au-delà, l'accès passe en pay-as-you-go (Stripe ci-dessus).
CC_API_RAG_FREE_QUOTA=2
CC_API_RAG_QUOTA_WINDOW_HOURS=24
# Plafond de sécurité anti-runaway en pay-as-you-go (requêtes max/fenêtre, même
# abonné). Garde-fou contre une session volée / boucle client. 0 = désactivé.
CC_API_RAG_PAYG_DAILY_CAP=200
# Rétention des `rag_interactions` (purge opportuniste à chaque /qa). 90 j par défaut.
CC_API_RAG_INTERACTION_RETENTION_DAYS=90

# Observabilité — Prometheus. Si CC_API_METRICS_TOKEN est défini, /metrics
# exige `Authorization: Bearer <token>` (le scraper Prometheus l'envoie).
CC_API_METRICS_TOKEN=

# Web
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_WEB_BASE=http://localhost:3000
SITE_URL=http://localhost:3000

# ARK
ARK_NAAN=99999
ARK_RESOLVER=https://n2t.net

# Corpus — dépôt séparé class-consciousness-corpus
# Optionnel : chemin absolu vers le clone du dépôt corpus (pour l'ingestion
# manuelle / bootstrap via scripts/ingest_corpus.py).
# Défaut si non défini : dossier voisin « ../class-consciousness-corpus ».
# CC_CORPUS_DIR=/chemin/absolu/vers/class-consciousness-corpus

# Auto-synchro du corpus — l'API récupère et ingère les NOUVEAUX numéros du repo
# corpus public toute seule (sans `git pull`, sans `git` dans l'image : fetch HTTP).
# Chaque cycle : lit le SHA de tête du repo (inchangé → rien) ; sinon télécharge le
# tarball et ingère les nouveaux numéros (idempotent par SHA256, embeddings GPU en
# local / CPU en prod). ACTIVÉE par défaut dans docker-compose.prod.yml ; OFF par
# défaut hors déploiement (tests/dev n'appellent pas GitHub).
CC_API_CORPUS_SYNC_ENABLED=false
CC_API_CORPUS_SYNC_INTERVAL_HOURS=24
# Avancé (défauts dans settings.py) : dépôt, branche, sélection, jeton GitHub
# optionnel (relève le quota API 60→5000/h ; inutile au rythme par défaut).
# CC_API_CORPUS_SYNC_REPO=Consansclasse/class-consciousness-corpus
# CC_API_CORPUS_SYNC_REF=main
# CC_API_CORPUS_SYNC_GLOB=**/bilan/bilan-[0-9][0-9][0-9].tei.xml
# CC_API_CORPUS_SYNC_TOKEN=
