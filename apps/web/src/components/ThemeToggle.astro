<button
  data-theme-toggle
  type="button"
  aria-label="Basculer le thème clair / sombre"
  aria-pressed="false"
  class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-black dark:border-white text-black dark:text-white transition-colors hover:border-darkpink hover:text-darkpink"
>
  <!-- soleil (visible en dark) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden h-4 w-4 dark:block"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- lune (visible en light) -->
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-4 w-4 dark:hidden"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  // Le composant peut être rendu PLUSIEURS fois sur une page (barre desktop +
  // barre mobile du header, menu compte…). On évite donc un `id` (qui serait
  // dupliqué) et on câble TOUTES les instances via `[data-theme-toggle]`. Le
  // script d'un composant Astro n'est inclus qu'une fois par page, même si le
  // composant est monté N fois → ce querySelectorAll les couvre toutes.
  const root = document.documentElement;
  const toggles = document.querySelectorAll("[data-theme-toggle]");
  // aria-pressed = true quand le thème sombre est actif (état annoncé aux
  // lecteurs d'écran). Synchronisé à l'init puis à chaque bascule, sur toutes
  // les instances pour qu'elles restent cohérentes.
  const syncPressed = () => {
    const dark = root.classList.contains("dark");
    toggles.forEach((b) => b.setAttribute("aria-pressed", String(dark)));
  };
  syncPressed();
  toggles.forEach((btn) =>
    btn.addEventListener("click", () => {
      const next = !root.classList.contains("dark");
      root.classList.toggle("dark", next);
      localStorage.setItem("theme", next ? "dark" : "light");
      syncPressed();
    }),
  );
</script>
