---
// SPDX-License-Identifier: AGPL-3.0-or-later
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  /** Empêche l'indexation (pages privées, accusés de réception…). */
  noindex?: boolean;
  /** Variante de couleur du header. "overlap" = texte blanc sur héro sombre. */
  headerVariant?: "solid" | "overlap";
  /** Désactive le header global (pages au chrome dédié, ex. /chat). */
  noHeader?: boolean;
}

const {
  title = "Conscience de classe — bibliothèque et outil du marxisme",
  description = "Bibliothèque et outil de travail pour l'étude du marxisme.",
  noindex = false,
  headerVariant = "solid",
  noHeader = false,
} = Astro.props;

// URL canonique : protège des doublons (paramètres, slash final, http/https).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Vignette de partage (1200×630, titre en UnifrakturMaguntia) — voir public/og.png.
const ogImage = new URL("/og.png", Astro.site).href;

const matomoUrl = import.meta.env.PUBLIC_MATOMO_URL;
const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <!-- Open Graph (partages Facebook, Instagram, messageries) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Conscience de classe" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Conscience de classe — archive Bilan" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Init thème : respecte localStorage, sinon préférence système.
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const dark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", dark);
        } catch (_e) {
          /* localStorage indisponible : on garde le défaut */
        }
      })();
    </script>

    {matomoUrl && (
      <script define:vars={{ matomoUrl, matomoSiteId }}>
        var _paq = (window._paq = window._paq || []);
        _paq.push(["disableCookies"]);
        _paq.push(["setDoNotTrack", true]);
        _paq.push(["anonymizeIp"]);
        _paq.push(["enableHeartBeatTimer", 30]);
        _paq.push(["trackPageView"]);
        _paq.push(["enableLinkTracking"]);
        (function () {
          var u = matomoUrl + "/";
          _paq.push(["setTrackerUrl", u + "matomo.php"]);
          _paq.push(["setSiteId", matomoSiteId]);
          var d = document;
          var g = d.createElement("script");
          var s = d.getElementsByTagName("script")[0];
          g.async = true;
          g.src = u + "matomo.js";
          s.parentNode.insertBefore(g, s);
        })();
      </script>
    )}
  </head>
  <body class="bg-white text-black dark:bg-black dark:text-white antialiased font-Scheherazade">
    {!noHeader && <SiteHeader variant={headerVariant} />}
    <slot />
  </body>
</html>
