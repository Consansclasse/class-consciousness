---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
import { BTN_FULL_CLASS, INPUT_CLASS } from "../lib/styles";
---

<BaseLayout title="Conscience de classe — Mot de passe oublié" noindex>
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <main class="flex flex-1 items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1
          class="font-Scheherazade text-2xl sm:text-3xl leading-snug text-black dark:text-white mb-2 uppercase"
        >
          MOT DE PASSE OUBLIÉ
        </h1>
        <p class="font-Scheherazade text-sm leading-relaxed text-black dark:text-white mb-8">
          Saisissez votre adresse : si un compte existe, vous recevrez un lien pour choisir un
          nouveau mot de passe, valable 1 heure.
        </p>

        <form id="forgot-form" autocomplete="on" class="space-y-4">
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-label="Adresse électronique"
            placeholder="vous@exemple.org"
            class={INPUT_CLASS}
          />
          <button
            type="submit"
            id="submit"
            class={BTN_FULL_CLASS}
          >
            ENVOYER LE LIEN
          </button>
        </form>

        <div id="result" class="mt-6" role="alert" aria-live="assertive"></div>
      </div>
    </main>
  </div>

  <script>
    import { API_BASE, escapeHtml } from "../lib/auth-client";
    const form = document.getElementById("forgot-form") as HTMLFormElement;
    const email = document.getElementById("email") as HTMLInputElement;
    const submit = document.getElementById("submit") as HTMLButtonElement;
    const result = document.getElementById("result") as HTMLElement;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/auth/forgot-password`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email: email.value.trim() }),
        });
        const data = (await res.json().catch(() => ({}))) as { devLink?: string };
        let html =
          "Si un compte correspond à cette adresse, un lien de réinitialisation vient d'être envoyé.";
        if (data.devLink) {
          html +=
            `<br /><br /><span class="uppercase tracking-wide text-xs">dev</span> ` +
            `<a href="${escapeHtml(data.devLink)}" class="text-darkpink underline decoration-1 underline-offset-2">réinitialiser maintenant</a>`;
        }
        result.className =
          "mt-6 font-Scheherazade text-sm leading-relaxed text-black dark:text-white";
        result.innerHTML = html;
        form.style.display = "none";
      } catch {
        result.className =
          "mt-6 font-Scheherazade text-sm leading-relaxed text-black dark:text-white";
        result.textContent = "La requête a échoué. Vérifiez votre connexion et réessayez.";
        submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
