import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Conscience de classe — Adhérer">
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <main class="flex flex-1 items-center justify-center px-6 py-24">
      <div class="mx-auto w-full max-w-2xl text-center">
        <h1
          class="font-Scheherazade text-4xl sm:text-5xl md:text-6xl leading-none text-black dark:text-white uppercase"
        >
          Adhérer
        </h1>
        <p
          class="mt-10 font-Scheherazade italic text-2xl sm:text-3xl md:text-4xl text-black dark:text-white"
        >
          ( à faire )
        </p>
        <p
          class="mt-10 font-Scheherazade text-sm sm:text-base text-black dark:text-white max-w-xl mx-auto leading-relaxed text-pretty"
        >
          L'archive est et restera librement accessible sans inscription. Le
          dispositif d'adhésion sera ouvert une fois l'association déclarée — pas
          avant. Aucune promesse, aucun palier affiché tant que rien n'est réel.
        </p>
        <p class="mt-8">
          <a
            href="/corpus"
            class="font-Scheherazade text-sm sm:text-base uppercase tracking-[0.2em] text-black dark:text-white hover:text-darkpink transition-colors"
          >
            Explorer le corpus &rarr;
          </a>
        </p>
      </div>
    </main>
  </div>
</BaseLayout>
