---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
import { BTN_FULL_CLASS, INPUT_CLASS } from "../lib/styles";
---

<BaseLayout title="Conscience de classe — Nouveau mot de passe" noindex>
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <main class="flex flex-1 items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1
          class="font-Scheherazade text-2xl sm:text-3xl leading-snug text-black dark:text-white mb-8 uppercase"
        >
          NOUVEAU MOT DE PASSE
        </h1>

        <form id="reset-form" autocomplete="on" class="space-y-4">
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="10"
            autocomplete="new-password"
            aria-label="Nouveau mot de passe"
            placeholder="Nouveau mot de passe (10 caractères minimum)"
            class={INPUT_CLASS}
          />
          <button
            type="submit"
            id="submit"
            class={BTN_FULL_CLASS}
          >
            ENREGISTRER
          </button>
        </form>

        <div id="result" class="mt-6" role="alert" aria-live="assertive"></div>
      </div>
    </main>
  </div>

  <script>
    import { API_BASE } from "../lib/auth-client";
    const form = document.getElementById("reset-form") as HTMLFormElement;
    const password = document.getElementById("password") as HTMLInputElement;
    const submit = document.getElementById("submit") as HTMLButtonElement;
    const result = document.getElementById("result") as HTMLElement;
    const token = new URLSearchParams(window.location.search).get("token");

    const note = (html: string) => {
      result.className =
        "mt-6 font-Scheherazade text-sm leading-relaxed text-black dark:text-white";
      result.innerHTML = html;
    };

    if (!token) {
      form.style.display = "none";
      note(
        'Ce lien de réinitialisation est incomplet. <a href="/forgot-password" class="text-darkpink underline">Demander un nouveau lien</a>.'
      );
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/auth/reset-password`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ token, password: password.value }),
        });
        if (res.ok) {
          form.style.display = "none";
          note(
            'Mot de passe enregistré. <a href="/login" class="text-darkpink underline">Se connecter</a>.'
          );
          return;
        }
        note(
          res.status === 422
            ? "Choisissez un mot de passe d'au moins 10 caractères."
            : 'Ce lien est invalide ou expiré. <a href="/forgot-password" class="text-darkpink underline">Demander un nouveau lien</a>.'
        );
        submit.disabled = false;
      } catch {
        note("La requête a échoué. Vérifiez votre connexion et réessayez.");
        submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
