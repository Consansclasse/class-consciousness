---
import ThemeToggle from "../components/ThemeToggle.astro";
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Conscience de classe — Connexion">
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <header
      class="flex shrink-0 items-center justify-between px-6 lg:px-10 py-5 border-b border-black dark:border-white"
    >
      <a
        href="/"
        class="font-Scheherazade text-xs sm:text-sm uppercase tracking-[0.25em] text-black dark:text-white hover:text-darkpink transition-colors"
      >
        ← Retour
      </a>
      <ThemeToggle />
    </header>

    <main class="flex flex-1 items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1
          class="font-Scheherazade text-2xl sm:text-3xl leading-snug text-black dark:text-white mb-2"
        >
          Se connecter
        </h1>
        <p
          class="font-Scheherazade text-sm leading-relaxed text-black dark:text-white opacity-70 mb-8"
        >
          Saisissez votre adresse électronique : nous vous enverrons un lien de
          connexion, valable 15 minutes. Aucun mot de passe.
        </p>

        <form id="login-form" autocomplete="on" class="space-y-4">
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-label="Adresse électronique"
            placeholder="vous@exemple.org"
            class="w-full border border-black dark:border-white bg-transparent px-4 py-3 font-Scheherazade text-base text-black dark:text-white outline-none focus-visible:border-darkpink"
          />
          <button
            type="submit"
            id="submit"
            class="w-full bg-darkpink text-white font-Scheherazade text-sm uppercase tracking-[0.2em] py-3 transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Recevoir un lien
          </button>
        </form>

        <div id="result" class="mt-6" aria-live="polite"></div>
      </div>
    </main>
  </div>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const email = document.getElementById("email") as HTMLInputElement;
    const submit = document.getElementById("submit") as HTMLButtonElement;
    const result = document.getElementById("result") as HTMLElement;
    const API_BASE = (
      import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
    ).replace(/\/$/, "");

    const escapeHtml = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    const note = (html: string) => {
      result.innerHTML = `<p class="font-Scheherazade text-sm leading-relaxed text-black dark:text-white">${html}</p>`;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const value = email.value.trim();
      if (!value) return;
      submit.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/auth/request-link`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email: value }),
        });
        if (!res.ok) {
          note("Une erreur est survenue. Réessayez dans un instant.");
          submit.disabled = false;
          return;
        }
        const data = (await res.json()) as { devMagicLink?: string };
        let html =
          "Si un compte correspond à cette adresse, un lien de connexion vient d'être envoyé. Vérifiez votre boîte de réception.";
        if (data.devMagicLink) {
          html +=
            `<br /><br /><span class="opacity-50 uppercase tracking-wide text-xs">dev</span> ` +
            `<a href="${escapeHtml(data.devMagicLink)}" class="text-darkpink underline decoration-1 underline-offset-2">ouvrir le lien de connexion</a>`;
        }
        note(html);
        form.style.display = "none";
      } catch {
        note("La requête a échoué. Vérifiez votre connexion et réessayez.");
        submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
