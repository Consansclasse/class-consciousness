---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../../../layouts/BaseLayout.astro";

type AuthorOut = {
  id: number;
  displayName: string;
};

type ArticleDetail = {
  id: number;
  slug: string;
  ark: string;
  title: string;
  author: AuthorOut;
  idxInIssue: number;
  nParagraphs: number;
  paragraphs: string[];
};

type IssueSummary = {
  slug: string;
  title: string;
};

// Base API pour le SSR (frontmatter = code serveur exécuté DANS le conteneur web).
// Priorité : API_INTERNAL_BASE_URL (réservée serveur, ex. http://api:8000 en Docker)
// > PUBLIC_API_BASE_URL > localhost. En `astro dev` (Node) process.env.X est exposé.
const apiBase = process.env.API_INTERNAL_BASE_URL ?? import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";

export async function getStaticPaths() {
  const apiBase = process.env.API_INTERNAL_BASE_URL ?? import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000";
  try {
    const res = await fetch(`${apiBase}/corpus?size=200`, {
      signal: AbortSignal.timeout(2000),
    });
    if (!res.ok) return [];
    const body = (await res.json()) as { items: { slug: string }[] };
    const paths = [];
    for (const issue of body.items) {
      const detailRes = await fetch(`${apiBase}/corpus/${issue.slug}`, {
        signal: AbortSignal.timeout(2000),
      });
      if (!detailRes.ok) continue;
      const detail = (await detailRes.json()) as { articles: { slug: string }[] };
      for (const article of detail.articles) {
        paths.push({ params: { issue: issue.slug, article: article.slug } });
      }
    }
    return paths;
  } catch {
    return [];
  }
}

const { issue, article } = Astro.params;

let detail: ArticleDetail | null = null;
let issueInfo: IssueSummary | null = null;
try {
  const res = await fetch(`${apiBase}/corpus/${issue}/${article}`, {
    signal: AbortSignal.timeout(2000),
  });
  if (res.ok) detail = (await res.json()) as ArticleDetail;
  const issueRes = await fetch(`${apiBase}/corpus/${issue}`, {
    signal: AbortSignal.timeout(2000),
  });
  if (issueRes.ok) issueInfo = (await issueRes.json()) as IssueSummary;
} catch {
  detail = null;
}
---

<BaseLayout title={detail ? `${detail.title} — Conscience de classe` : "Article introuvable"}>
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <main class="flex-1 px-6 md:px-12 lg:px-16 pt-24 lg:pt-28 pb-16 md:pb-24">
      <div class="mx-auto w-full max-w-3xl">
        {detail ? (
          <>
            {issueInfo && (
              <p class="font-Scheherazade text-xs sm:text-sm uppercase tracking-[0.25em] text-black dark:text-white mb-6">
                {issueInfo.title}
              </p>
            )}
            <h1 class="font-Scheherazade text-3xl sm:text-4xl md:text-5xl leading-tight text-black dark:text-white uppercase">
              {detail.title}
            </h1>
            <p class="mt-3 font-Scheherazade italic text-base sm:text-lg text-black dark:text-white">
              {detail.author.displayName}
            </p>
            <p class="mt-1 font-Scheherazade text-xs uppercase tracking-[0.25em] text-black dark:text-white">
              {detail.ark}
            </p>

            {/* Lecture audio (TTS) — Web Speech API, 100% navigateur, aucun appel réseau. */}
            <div
              id="tts-controls"
              class="mt-8 flex flex-wrap items-center gap-3"
              data-tts-title={detail.title}
            >
              <button
                id="tts-toggle"
                type="button"
                aria-pressed="false"
                aria-label="Écouter l'article"
                class="inline-flex items-center gap-2 rounded-full border border-black dark:border-white px-4 py-2 font-Scheherazade text-sm text-black dark:text-white transition-colors hover:border-darkpink hover:text-darkpink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-darkpink"
              >
                <span id="tts-toggle-icon" aria-hidden="true">▶</span>
                <span id="tts-toggle-label">Écouter</span>
              </button>
              <button
                id="tts-stop"
                type="button"
                aria-label="Arrêter la lecture"
                hidden
                class="inline-flex items-center gap-2 rounded-full border border-black dark:border-white px-4 py-2 font-Scheherazade text-sm text-black dark:text-white transition-colors hover:border-darkpink hover:text-darkpink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-darkpink"
              >
                <span aria-hidden="true">■</span>
                <span>Stop</span>
              </button>
              <p
                id="tts-unsupported"
                hidden
                class="font-Scheherazade italic text-sm text-black/70 dark:text-white/70"
              >
                La lecture audio n'est pas disponible dans ce navigateur.
              </p>
            </div>

            <article class="mt-12 space-y-6" data-article-body>
              {detail.paragraphs.map((p) => (
                <p class="font-Scheherazade text-base sm:text-lg text-black dark:text-white leading-relaxed text-pretty">
                  {p}
                </p>
              ))}
            </article>
          </>
        ) : (
          <div class="border-y border-black dark:border-white py-24 text-center">
            <p class="font-Scheherazade italic text-lg sm:text-xl text-black dark:text-white">
              Article introuvable.
            </p>
            <a
              href="/corpus"
              class="mt-6 inline-block font-Scheherazade text-sm sm:text-base text-black dark:text-white hover:text-darkpink underline"
            >
              Retour au corpus
            </a>
          </div>
        )}
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // Îlot client — Lecture audio via Web Speech API (aucune dépendance, aucun réseau).
  const controls = document.getElementById("tts-controls");
  const toggleBtn = document.getElementById("tts-toggle") as HTMLButtonElement | null;
  const toggleLabel = document.getElementById("tts-toggle-label");
  const toggleIcon = document.getElementById("tts-toggle-icon");
  const stopBtn = document.getElementById("tts-stop") as HTMLButtonElement | null;
  const unsupported = document.getElementById("tts-unsupported");

  const synth = typeof window !== "undefined" ? window.speechSynthesis : undefined;

  // Si l'API n'est pas disponible : on masque les contrôles, on affiche le message.
  if (!synth || !controls || !toggleBtn) {
    toggleBtn?.setAttribute("hidden", "");
    stopBtn?.setAttribute("hidden", "");
    unsupported?.removeAttribute("hidden");
  } else {
    // Récupère les énoncés à lire : titre puis chaque paragraphe rendu (DOM only).
    function collectChunks(): string[] {
      const chunks: string[] = [];
      const title = controls?.getAttribute("data-tts-title")?.trim();
      if (title) chunks.push(title);
      const body = document.querySelector("[data-article-body]");
      if (body) {
        for (const p of Array.from(body.querySelectorAll("p"))) {
          const text = (p.textContent ?? "").trim();
          if (text) chunks.push(text);
        }
      }
      return chunks;
    }

    // getVoices() peut être vide au 1er appel → on écoute aussi `voiceschanged`.
    let frVoice: SpeechSynthesisVoice | null = null;
    function pickFrVoice() {
      const voices = synth!.getVoices();
      frVoice =
        voices.find((v) => v.lang?.toLowerCase().startsWith("fr")) ?? null;
    }
    pickFrVoice();
    synth.addEventListener("voiceschanged", pickFrVoice);

    let speaking = false;
    let paused = false;

    function setIdleUI() {
      speaking = false;
      paused = false;
      if (toggleLabel) toggleLabel.textContent = "Écouter";
      if (toggleIcon) toggleIcon.textContent = "▶";
      toggleBtn!.setAttribute("aria-pressed", "false");
      toggleBtn!.setAttribute("aria-label", "Écouter l'article");
      stopBtn?.setAttribute("hidden", "");
    }

    function setPlayingUI() {
      if (toggleLabel) toggleLabel.textContent = "Pause";
      if (toggleIcon) toggleIcon.textContent = "⏸";
      toggleBtn!.setAttribute("aria-pressed", "true");
      toggleBtn!.setAttribute("aria-label", "Mettre la lecture en pause");
      stopBtn?.removeAttribute("hidden");
    }

    function setPausedUI() {
      if (toggleLabel) toggleLabel.textContent = "Reprendre";
      if (toggleIcon) toggleIcon.textContent = "▶";
      toggleBtn!.setAttribute("aria-pressed", "false");
      toggleBtn!.setAttribute("aria-label", "Reprendre la lecture");
      stopBtn?.removeAttribute("hidden");
    }

    function start() {
      const chunks = collectChunks();
      if (chunks.length === 0) return;
      synth!.cancel(); // repart propre
      speaking = true;
      paused = false;
      setPlayingUI();
      chunks.forEach((chunk, i) => {
        const u = new SpeechSynthesisUtterance(chunk);
        u.lang = "fr-FR";
        if (frVoice) u.voice = frVoice;
        if (i === chunks.length - 1) {
          u.addEventListener("end", () => {
            // Fin naturelle de la lecture (pas un cancel).
            if (speaking) setIdleUI();
          });
        }
        synth!.speak(u);
      });
    }

    toggleBtn.addEventListener("click", () => {
      if (!speaking) {
        start();
        return;
      }
      if (paused) {
        synth.resume();
        paused = false;
        setPlayingUI();
      } else {
        synth.pause();
        paused = true;
        setPausedUI();
      }
    });

    stopBtn?.addEventListener("click", () => {
      synth.cancel();
      setIdleUI();
    });

    // Coupe la synthèse si on quitte la page (évite une voix qui continue).
    window.addEventListener("beforeunload", () => synth.cancel());
    window.addEventListener("pagehide", () => synth.cancel());

    setIdleUI();
  }
</script>
