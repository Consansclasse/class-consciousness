---
import ThemeToggle from "../components/ThemeToggle.astro";
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Conscience de classe — Abonnement">
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <header
      class="flex shrink-0 items-center justify-between px-6 lg:px-10 py-5 border-b border-black dark:border-white"
    >
      <a
        href="/"
        class="font-Scheherazade text-xs sm:text-sm uppercase tracking-[0.25em] text-black dark:text-white hover:text-darkpink transition-colors"
      >
        ← Retour
      </a>
      <ThemeToggle />
    </header>

    <main class="flex flex-1 items-center justify-center px-6 py-16">
      <div class="w-full max-w-lg">
        <h1
          class="font-Scheherazade text-2xl sm:text-3xl leading-snug text-black dark:text-white mb-3"
        >
          S'abonner à l'assistant
        </h1>
        <p
          class="font-Scheherazade text-sm sm:text-base leading-relaxed text-black dark:text-white opacity-80 mb-6"
        >
          La <strong>lecture du corpus et des textes</strong> est, et restera
          toujours, libre et sans quota. Seul l'assistant de recherche
          sourcé — coûteux en calcul — est limité au-delà d'un usage quotidien
          gratuit. L'abonnement mensuel lève cette limite pour un usage soutenu.
        </p>
        <ul
          class="font-Scheherazade text-sm leading-relaxed text-black dark:text-white border-t border-b border-black dark:border-white divide-y divide-black dark:divide-white mb-8"
        >
          <li class="py-3">Davantage de requêtes quotidiennes à l'assistant</li>
          <li class="py-3">Résiliable à tout moment, sans engagement</li>
          <li class="py-3">
            Soutient une archive ouverte, financée par sa communauté
          </li>
        </ul>

        <button
          type="button"
          id="subscribe"
          class="w-full bg-darkpink text-white font-Scheherazade text-sm uppercase tracking-[0.2em] py-3 transition-opacity hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          S'abonner
        </button>
        <p
          class="font-Scheherazade text-xs leading-relaxed text-black dark:text-white opacity-60 mt-3"
        >
          Le paiement est traité par Stripe. Un compte est requis : si vous
          n'êtes pas connecté·e, vous serez d'abord invité·e à l'être.
        </p>

        <div id="result" class="mt-6" aria-live="polite"></div>
      </div>
    </main>
  </div>

  <script>
    const btn = document.getElementById("subscribe") as HTMLButtonElement;
    const result = document.getElementById("result") as HTMLElement;
    const API_BASE = (
      import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
    ).replace(/\/$/, "");

    const note = (text: string) => {
      result.innerHTML = `<p class="font-Scheherazade text-sm leading-relaxed text-black dark:text-white">${text}</p>`;
    };

    btn.addEventListener("click", async () => {
      btn.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/abonnements/checkout`, {
          method: "POST",
          credentials: "include",
        });
        if (res.status === 401) {
          window.location.href = "/connexion";
          return;
        }
        if (!res.ok) {
          note("L'abonnement est momentanément indisponible. Réessayez plus tard.");
          btn.disabled = false;
          return;
        }
        const data = (await res.json()) as { redirectUrl: string };
        window.location.href = data.redirectUrl;
      } catch {
        note("La requête a échoué. Vérifiez votre connexion.");
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
