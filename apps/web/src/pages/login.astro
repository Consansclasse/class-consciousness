---
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
import { BTN_FULL_CLASS, INPUT_CLASS } from "../lib/styles";
---

<BaseLayout title="Conscience de classe — Connexion" noindex>
  <div class="flex min-h-dvh flex-col bg-white dark:bg-black">
    <main class="flex flex-1 items-center justify-center px-6 py-16">
      <div class="w-full max-w-md">
        <h1
          class="font-Scheherazade text-2xl sm:text-3xl leading-snug text-black dark:text-white mb-8 uppercase"
        >
          SE CONNECTER
        </h1>

        <form id="login-form" autocomplete="on" class="space-y-4">
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            aria-label="Adresse électronique"
            placeholder="vous@exemple.org"
            class={INPUT_CLASS}
          />
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            aria-label="Mot de passe"
            placeholder="Mot de passe"
            class={INPUT_CLASS}
          />
          <button
            type="submit"
            id="submit"
            class={BTN_FULL_CLASS}
          >
            SE CONNECTER
          </button>
        </form>

        <div id="result" class="mt-6" role="alert" aria-live="assertive"></div>

        <nav class="mt-8 flex flex-col gap-2 font-Scheherazade text-sm uppercase tracking-[0.2em]">
          <a href="/register" class="text-darkpink underline decoration-1 underline-offset-2"
            >Créer un compte</a
          >
          <a
            href="/forgot-password"
            class="text-darkpink underline decoration-1 underline-offset-2">Mot de passe oublié ?</a
          >
        </nav>
      </div>
    </main>
  </div>

  <script>
    import { API_BASE } from "../lib/auth-client";
    const form = document.getElementById("login-form") as HTMLFormElement;
    const email = document.getElementById("email") as HTMLInputElement;
    const password = document.getElementById("password") as HTMLInputElement;
    const submit = document.getElementById("submit") as HTMLButtonElement;
    const result = document.getElementById("result") as HTMLElement;

    const note = (text: string) => {
      result.textContent = text;
      result.className =
        "mt-6 font-Scheherazade text-sm leading-relaxed text-black dark:text-white";
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/auth/login`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ email: email.value.trim(), password: password.value }),
        });
        if (res.ok) {
          // Retour à la destination demandée (?next=…) si elle est interne et
          // sûre (chemin relatif, pas de //). Défaut : l'assistant.
          const raw = new URLSearchParams(window.location.search).get("next");
          const dest = raw && raw.startsWith("/") && !raw.startsWith("//") ? raw : "/chat";
          window.location.href = dest;
          return;
        }
        const data = (await res.json().catch(() => ({}))) as { detail?: string };
        note(data.detail ?? "Connexion impossible. Vérifiez vos identifiants.");
        submit.disabled = false;
      } catch {
        note("La requête a échoué. Vérifiez votre connexion et réessayez.");
        submit.disabled = false;
      }
    });
  </script>
</BaseLayout>
