---
import ThemeToggle from "../components/ThemeToggle.astro";
// SPDX-License-Identifier: AGPL-3.0-or-later
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Conscience de classe — Conversation" noHeader>
  <div class="flex h-dvh bg-white dark:bg-black">
    <!-- Barre latérale : historique des conversations (façon fil persistant). -->
    <aside
      id="sidebar"
      aria-label="Vos conversations"
      class="fixed inset-y-0 left-0 z-30 flex w-72 -translate-x-full flex-col border-r border-black bg-white transition-transform dark:border-white dark:bg-black lg:static lg:translate-x-0"
    >
      <div
        class="flex shrink-0 items-center justify-between border-b border-black px-4 py-5 dark:border-white"
      >
        <span
          class="font-Scheherazade text-xs uppercase tracking-[0.25em] text-black dark:text-white"
          >Conversations</span
        >
        <button
          type="button"
          id="sidebar-close"
          aria-label="Fermer le panneau"
          class="font-Scheherazade text-lg leading-none text-black dark:text-white lg:hidden"
        >
          ×
        </button>
      </div>
      <div class="shrink-0 px-4 py-3">
        <button
          type="button"
          id="new-conv"
          class="w-full border border-black px-3 py-2 font-Scheherazade text-xs uppercase tracking-[0.2em] text-black transition-colors hover:bg-darkpink hover:border-darkpink hover:text-white dark:border-white dark:text-white"
        >
          + Nouvelle conversation
        </button>
      </div>
      <ul
        id="conv-list"
        class="flex-1 divide-y divide-black/20 overflow-y-auto dark:divide-white/20"
      ></ul>
    </aside>

    <!-- Voile sombre derrière le tiroir mobile. -->
    <div
      id="sidebar-backdrop"
      class="fixed inset-0 z-20 hidden bg-black/40 lg:hidden"
    >
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <!-- Header minimal, séparé du contenu par une fine ligne noire -->
      <header
        class="flex shrink-0 items-center justify-between border-b border-black px-6 py-5 dark:border-white lg:px-10"
      >
        <div class="flex items-center gap-4">
          <button
            type="button"
            id="sidebar-open"
            aria-label="Ouvrir le panneau des conversations"
            class="font-Scheherazade text-xl leading-none text-black dark:text-white lg:hidden"
          >
            ☰
          </button>
          <a
            href="/"
            class="font-Scheherazade text-xs uppercase tracking-[0.25em] text-black transition-colors hover:text-darkpink dark:text-white sm:text-sm"
          >
            ← Retour
          </a>
        </div>
        <a
          href="/"
          class="hidden font-Scheherazade text-sm uppercase tracking-[0.2em] text-black transition-colors hover:text-darkpink dark:text-white sm:inline"
        >
          Conscience de classe
        </a>
        <div class="flex items-center gap-6">
          <a
            href="/corpus"
            class="hidden font-Scheherazade text-xs uppercase tracking-[0.25em] text-black transition-colors hover:text-darkpink dark:text-white sm:inline"
          >
            Le corpus
          </a>
          <button
            type="button"
            id="logout"
            aria-label="Se déconnecter"
            class="font-Scheherazade text-xs uppercase tracking-[0.25em] text-black transition-colors hover:text-darkpink dark:text-white"
          >
            Déconnexion
          </button>
          <ThemeToggle />
        </div>
      </header>

      <!-- Zone scrollable : flex column qui occupe toute la hauteur disponible -->
      <main
        id="conv"
        class="flex flex-1 flex-col overflow-y-auto"
        aria-live="polite"
      >
        <div class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-6 md:px-10">
          <!-- Messages : séparés par fines lignes noires -->
          <ol
            id="messages"
            class="flex-1 divide-y divide-black py-8 dark:divide-white"
          ></ol>
        </div>
      </main>

      <!-- Input : encadré d'une fine ligne noire, collé en bas avec un peu d'air -->
      <form
        id="chat-form"
        autocomplete="off"
        class="shrink-0 bg-white px-6 pb-5 pt-2 dark:bg-black md:px-10"
      >
        <div
          class="mx-auto flex w-full max-w-3xl items-end gap-3 border border-black px-4 py-3 dark:border-white"
        >
          <textarea
            id="chat-input"
            name="q"
            rows="1"
            maxlength="500"
            aria-label="Votre question"
            class="min-h-[28px] max-h-48 flex-1 resize-none border-none bg-transparent py-1 font-Scheherazade text-lg leading-relaxed text-black outline-none dark:text-white"
          ></textarea>

          <button
            type="submit"
            id="chat-submit"
            aria-label="Envoyer"
            disabled
            class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-darkpink text-white transition-opacity hover:opacity-90 focus-visible:opacity-90 disabled:cursor-not-allowed disabled:opacity-25"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M12 19V5"></path>
              <path d="m5 12 7-7 7 7"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById("chat-form") as HTMLFormElement;
    const ta = document.getElementById("chat-input") as HTMLTextAreaElement;
    const btn = document.getElementById("chat-submit") as HTMLButtonElement;
    const list = document.getElementById("messages") as HTMLOListElement;
    const conv = document.getElementById("conv") as HTMLElement;
    const convList = document.getElementById("conv-list") as HTMLUListElement;
    const sidebar = document.getElementById("sidebar") as HTMLElement;
    const backdrop = document.getElementById("sidebar-backdrop") as HTMLElement;

    // L'API min_length de la question est 3 caractères (cf. schemas/qa.py).
    const MIN_LEN = 3;
    const API_BASE = (
      import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8000"
    ).replace(/\/$/, "");

    // Le cookie de session est porté par l'API (SessionMiddleware) : tout appel
    // authentifié doit l'envoyer. `same-origin` ne suffit pas (l'API est sur un
    // autre sous-domaine) — `include` est obligatoire.
    const withCreds: RequestInit = { credentials: "include" };

    type Citation = {
      sourceId: string;
      issueSlug: string;
      issueArk: string;
      articleSlug: string;
      articleArk: string;
      articleTitle: string;
      authorName: string;
      charStart: number;
      charEnd: number;
    };
    type Sentence = {
      text: string;
      citations: string[];
      verified: boolean;
      paragraphe: number;
    };
    type QaResponse = {
      answer: string | null;
      sentences: Sentence[];
      citedChunks: Citation[];
      incomplete: boolean;
      refusedReason: string | null;
      interactionId: number | null;
      conversationId: number | null;
    };
    type ConvSummary = { id: number; title: string; updatedAt: string };
    type ConvMessage = QaResponse & { question: string };
    type ConvDetail = { id: number; title: string; messages: ConvMessage[] };

    // Fil courant — null tant qu'aucune question n'a ouvert (ou rouvert) un fil.
    let currentConversationId: number | null = null;

    const autosize = () => {
      ta.style.height = "auto";
      ta.style.height = Math.min(ta.scrollHeight, 192) + "px";
    };

    const escapeHtml = (s: string) =>
      s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const scrollDown = () => {
      requestAnimationFrame(() => {
        conv.scrollTo({ top: conv.scrollHeight, behavior: "smooth" });
      });
    };

    const noteHtml = (text: string) =>
      `<p class="font-Scheherazade italic text-sm sm:text-base leading-relaxed text-black dark:text-white">${escapeHtml(text)}</p>`;

    // Estimation de latence du pipeline RAG, mesurée bout-en-bout (~70 s :
    // génération ~52 s + vérification d'ancrage ~19 s). Sert de cible au
    // minuteur — informative, jamais bloquante.
    const ESTIMATE_S = 70;

    // `83` → `1:23` (minutes:secondes), format minuteur.
    const fmtClock = (s: number) =>
      `${Math.floor(s / 60)}:${(s % 60).toString().padStart(2, "0")}`;

    // Indicateur d'attente : libellé d'étape courante + barre de progression +
    // minuteur (temps écoulé / estimation). Le pipeline RAG prenant ~1 min, une
    // attente muette serait anxiogène — on rend la progression lisible. Renvoie
    // `setLabel` (maj du libellé d'étape) et `stop` (arrêt du minuteur).
    const startWaiter = (slot: HTMLElement) => {
      slot.innerHTML = `
        <div class="space-y-2.5">
          <p data-label class="font-Scheherazade italic text-sm sm:text-base leading-relaxed text-black dark:text-white">Analyse de la question…</p>
          <div
            data-bar
            role="progressbar"
            aria-label="Progression de la réponse"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            class="h-2 w-full border border-black dark:border-white"
          >
            <div
              data-fill
              class="h-full bg-darkpink transition-[width] duration-1000 ease-linear"
              style="width:0%"
            ></div>
          </div>
          <p
            data-time
            class="font-Scheherazade text-xs uppercase tracking-[0.15em] text-black dark:text-white"
          >0:00 écoulé · estimation ≈ ${fmtClock(ESTIMATE_S)}</p>
        </div>`;
      const label = slot.querySelector("[data-label]") as HTMLElement;
      const bar = slot.querySelector("[data-bar]") as HTMLElement;
      const fill = slot.querySelector("[data-fill]") as HTMLElement;
      const time = slot.querySelector("[data-time]") as HTMLElement;
      const t0 = Date.now();
      const tick = () => {
        const el = Math.round((Date.now() - t0) / 1000);
        // La barre plafonne à 96 % : elle ne se « remplit » jamais tant que la
        // réponse vérifiée n'est pas arrivée — pas de faux signal d'achèvement.
        const pct = Math.min(96, (el / ESTIMATE_S) * 100);
        fill.style.width = pct + "%";
        bar.setAttribute("aria-valuenow", String(Math.round(pct)));
        time.textContent =
          el < ESTIMATE_S
            ? `${fmtClock(el)} écoulé · estimation ≈ ${fmtClock(ESTIMATE_S)}`
            : `${fmtClock(el)} écoulé · réponse imminente…`;
      };
      const id = window.setInterval(tick, 1000);
      return {
        setLabel: (txt: string) => {
          label.textContent = txt;
        },
        stop: () => window.clearInterval(id),
      };
    };

    // `bilan-3` → `Bilan n°3` (libellé lisible du numéro).
    const issueLabel = (slug: string) => {
      const m = slug.match(/^bilan-0*(\d+)$/);
      return m ? `Bilan n°${m[1]}` : slug;
    };

    // Rend une réponse RAG structurée : chaque phrase vérifiée porte ses renvois
    // numérotés ⁽ⁿ⁾, les paragraphes d'origine sont préservés, et l'appareil de
    // sources complet (auteur, article, numéro, ARK, offsets) est listé dessous.
    const renderAnswer = (sentences: Sentence[], cited: Citation[]) => {
      const byId = new Map(cited.map((c) => [c.sourceId, c]));
      const verified = sentences.filter((s) => s.verified);
      const order: string[] = [];
      const numFor = (id: string) => {
        let i = order.indexOf(id);
        if (i === -1) {
          order.push(id);
          i = order.length - 1;
        }
        return i + 1;
      };
      // Regroupe les phrases par paragraphe d'origine.
      const paras = new Map<number, Sentence[]>();
      for (const s of verified) {
        const arr = paras.get(s.paragraphe) ?? [];
        arr.push(s);
        paras.set(s.paragraphe, arr);
      }
      let html = "";
      for (const [, group] of [...paras.entries()].sort((a, b) => a[0] - b[0])) {
        const inner = group
          .map((s) => {
            const sup = s.citations
              .filter((id) => id !== "none")
              .map(
                (id) => `<sup class="text-darkpink">(${numFor(id)})</sup>`,
              )
              .join("");
            return `${escapeHtml(s.text)}${sup}`;
          })
          .join(" ");
        html += `<p class="font-Scheherazade text-base sm:text-lg leading-relaxed text-black dark:text-white text-pretty mb-4">${inner}</p>`;
      }
      if (order.length > 0) {
        const items = order
          .map((id, idx) => {
            const c = byId.get(id);
            let inner: string;
            if (c) {
              const ref = `${escapeHtml(c.authorName)}, « ${escapeHtml(c.articleTitle)} », ${escapeHtml(issueLabel(c.issueSlug))}`;
              inner =
                `<a href="/corpus/${encodeURIComponent(c.issueSlug)}/${encodeURIComponent(c.articleSlug)}" ` +
                `class="hover:text-darkpink underline decoration-1 underline-offset-2">${ref}</a>` +
                ` <span>— ${escapeHtml(c.articleArk)}, car. ${c.charStart}–${c.charEnd}</span>`;
            } else {
              inner = escapeHtml(id);
            }
            return `<li class="font-Scheherazade text-xs sm:text-sm text-black dark:text-white">(${idx + 1}) ${inner}</li>`;
          })
          .join("");
        html +=
          `<div class="mt-5 border-t border-black dark:border-white pt-3">` +
          `<p class="font-Scheherazade text-xs uppercase tracking-[0.2em] mb-2">Sources</p>` +
          `<ol class="space-y-1.5">${items}</ol></div>`;
      }
      return html;
    };

    // Classes communes des boutons de feedback — sobres, cohérentes avec le site.
    const FB_BTN =
      "border border-black dark:border-white px-3 py-1 font-Scheherazade " +
      "text-xs uppercase tracking-[0.15em] text-black dark:text-white " +
      "hover:bg-darkpink hover:text-white hover:border-darkpink transition-colors";

    // Transmet un retour de lecteur à l'API. `kind` ∈ UP | DOWN | FLAG.
    const sendFeedback = async (
      interactionId: number,
      kind: string,
      comment: string | null = null,
    ): Promise<boolean> => {
      try {
        const res = await fetch(
          `${API_BASE}/qa/interactions/${interactionId}/feedback`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ kind, comment }),
            ...withCreds,
          },
        );
        return res.ok;
      } catch {
        return false;
      }
    };

    // Ajoute sous une réponse vérifiée la zone de feedback (pouce / signalement).
    // Ferme la boucle humaine : chaque retour est rattaché à l'interaction RAG.
    const attachFeedback = (slot: HTMLElement, interactionId: number) => {
      const box = document.createElement("div");
      box.className = "mt-5 border-t border-black dark:border-white pt-3";
      box.innerHTML = `
        <p class="font-Scheherazade text-xs uppercase tracking-[0.2em] mb-2">Votre retour</p>
        <div data-fb-actions class="flex flex-wrap gap-2">
          <button type="button" data-fb="UP" class="${FB_BTN}" aria-label="Signaler que la réponse est utile">Réponse utile</button>
          <button type="button" data-fb="DOWN" class="${FB_BTN}" aria-label="Signaler que la réponse est insuffisante">Réponse insuffisante</button>
          <button type="button" data-fb="FLAG" class="${FB_BTN}" aria-label="Signaler une erreur dans la réponse">Signaler une erreur</button>
        </div>`;
      slot.appendChild(box);

      const done = (msg: string) => {
        box.innerHTML = `<p class="font-Scheherazade italic text-sm leading-relaxed text-black dark:text-white">${escapeHtml(msg)}</p>`;
      };
      const actions = box.querySelector("[data-fb-actions]") as HTMLElement;

      const openFlagForm = () => {
        actions.innerHTML = `
          <div class="w-full space-y-2">
            <textarea
              data-fb-comment
              rows="2"
              maxlength="2000"
              aria-label="Précisez l'erreur signalée"
              placeholder="Quelle citation ou affirmation pose problème ?"
              class="w-full resize-none border border-black dark:border-white bg-transparent p-2 font-Scheherazade text-sm leading-relaxed text-black dark:text-white outline-none"
            ></textarea>
            <button type="button" data-fb-send class="${FB_BTN}">Envoyer le signalement</button>
          </div>`;
        const comment = actions.querySelector(
          "[data-fb-comment]",
        ) as HTMLTextAreaElement;
        comment.focus();
        const send = actions.querySelector("[data-fb-send]") as HTMLButtonElement;
        send.addEventListener("click", async () => {
          send.disabled = true;
          const ok = await sendFeedback(
            interactionId,
            "FLAG",
            comment.value.trim() || null,
          );
          done(
            ok
              ? "Merci, le signalement a été transmis."
              : "Le signalement n'a pas pu être envoyé.",
          );
        });
      };

      box.querySelectorAll("[data-fb]").forEach((b) => {
        b.addEventListener("click", async () => {
          const kind = (b as HTMLElement).dataset.fb ?? "";
          if (kind === "FLAG") {
            openFlagForm();
            return;
          }
          const ok = await sendFeedback(interactionId, kind);
          done(
            ok
              ? "Merci de votre retour."
              : "Le retour n'a pas pu être envoyé.",
          );
        });
      });
    };

    // Affiche la réponse finale (vérifiée) ou le message de refus adéquat.
    const renderResult = (data: QaResponse, slot: HTMLElement) => {
      const sentences = data.sentences ?? [];
      const hasAnswer = !!data.answer && sentences.some((s) => s.verified);
      if (!hasAnswer) {
        slot.innerHTML = noteHtml(
          data.refusedReason === "no_relevant_chunks"
            ? "Le corpus disponible ne couvre pas cette question."
            : "Je ne peux pas répondre à partir des sources disponibles.",
        );
        return;
      }
      let html = renderAnswer(sentences, data.citedChunks ?? []);
      if (data.incomplete) {
        html += noteHtml(
          "Réponse partielle : les phrases non adossées à une citation vérifiée ont été retirées.",
        );
      }
      slot.innerHTML = html;
      if (data.interactionId != null) attachFeedback(slot, data.interactionId);
    };

    // Crée la ligne d'un échange (question + emplacement de réponse) et renvoie
    // le slot de réponse. Partagé entre une question en direct et le rejeu de
    // l'historique.
    const addExchange = (question: string): HTMLElement => {
      const li = document.createElement("li");
      li.className = "space-y-4 py-8 first:pt-0 last:pb-0";
      li.innerHTML = `
        <p class="font-Scheherazade text-xl sm:text-2xl leading-snug text-black dark:text-white text-pretty">${escapeHtml(question)}</p>
        <div class="answer"></div>
      `;
      list.appendChild(li);
      return li.querySelector(".answer") as HTMLElement;
    };

    // ───────────────────────── Barre latérale (historique) ──────────────────

    const closeSidebar = () => {
      sidebar.classList.add("-translate-x-full");
      backdrop.classList.add("hidden");
    };
    const openSidebar = () => {
      sidebar.classList.remove("-translate-x-full");
      backdrop.classList.remove("hidden");
    };

    // Met à jour l'URL (?c=…) sans recharger — deep-link d'un fil.
    const setUrl = (id: number | null) => {
      const url = new URL(window.location.href);
      if (id == null) url.searchParams.delete("c");
      else url.searchParams.set("c", String(id));
      url.searchParams.delete("q");
      window.history.replaceState({}, "", url);
    };

    const CONV_BTN_BASE =
      "flex-1 truncate text-left font-Scheherazade text-sm text-black dark:text-white";

    // Rend une ligne de conversation dans la liste latérale.
    const renderConvItem = (c: ConvSummary): HTMLLIElement => {
      const li = document.createElement("li");
      li.dataset.id = String(c.id);
      const active = c.id === currentConversationId;
      li.className =
        "group flex items-center gap-1 px-3 py-2.5 " +
        (active ? "bg-darkpink/10" : "hover:bg-black/5 dark:hover:bg-white/10");
      li.innerHTML = `
        <button type="button" data-select class="${CONV_BTN_BASE}" title="${escapeHtml(c.title)}">${escapeHtml(c.title)}</button>
        <button type="button" data-rename aria-label="Renommer la conversation" class="shrink-0 px-1 font-Scheherazade text-xs text-black hover:text-darkpink dark:text-white">✎</button>
        <button type="button" data-delete aria-label="Supprimer la conversation" class="shrink-0 px-1 font-Scheherazade text-xs text-black hover:text-darkpink dark:text-white">×</button>
      `;
      (li.querySelector("[data-select]") as HTMLElement).addEventListener(
        "click",
        () => void selectConversation(c.id),
      );
      (li.querySelector("[data-rename]") as HTMLElement).addEventListener(
        "click",
        () => startRename(li, c),
      );
      (li.querySelector("[data-delete]") as HTMLElement).addEventListener(
        "click",
        () => void deleteConversation(c.id),
      );
      return li;
    };

    let conversations: ConvSummary[] = [];

    const renderConvList = () => {
      convList.innerHTML = "";
      if (conversations.length === 0) {
        const li = document.createElement("li");
        li.className =
          "px-3 py-4 font-Scheherazade text-xs italic text-black dark:text-white";
        li.textContent = "Aucune conversation pour l'instant.";
        convList.appendChild(li);
        return;
      }
      for (const c of conversations) convList.appendChild(renderConvItem(c));
    };

    const loadConversations = async () => {
      try {
        const res = await fetch(`${API_BASE}/conversations`, withCreds);
        if (res.status === 401) return void redirectToLogin();
        if (!res.ok) return;
        conversations = (await res.json()) as ConvSummary[];
        renderConvList();
      } catch {
        /* réseau indisponible — la liste reste vide, non bloquant */
      }
    };

    // Édition inline du titre : remplace le bouton par un champ. Entrée valide
    // (PATCH), Échap annule.
    const startRename = (li: HTMLLIElement, c: ConvSummary) => {
      const input = document.createElement("input");
      input.type = "text";
      input.value = c.title;
      input.maxLength = 200;
      input.setAttribute("aria-label", "Nouveau titre de la conversation");
      input.className =
        "flex-1 border border-black dark:border-white bg-transparent px-1 py-0.5 font-Scheherazade text-sm text-black dark:text-white outline-none";
      const selectBtn = li.querySelector("[data-select]") as HTMLElement;
      li.replaceChild(input, selectBtn);
      input.focus();
      input.select();
      const commit = async () => {
        const title = input.value.trim();
        if (title && title !== c.title) {
          try {
            await fetch(`${API_BASE}/conversations/${c.id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ title }),
              ...withCreds,
            });
            c.title = title;
          } catch {
            /* échec réseau — on réaffiche l'ancien titre */
          }
        }
        renderConvList();
      };
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          void commit();
        } else if (e.key === "Escape") {
          renderConvList();
        }
      });
      input.addEventListener("blur", () => void commit());
    };

    const deleteConversation = async (id: number) => {
      if (!window.confirm("Supprimer définitivement cette conversation ?")) return;
      try {
        await fetch(`${API_BASE}/conversations/${id}`, {
          method: "DELETE",
          ...withCreds,
        });
      } catch {
        return;
      }
      conversations = conversations.filter((c) => c.id !== id);
      if (currentConversationId === id) startNewConversation();
      renderConvList();
    };

    // Charge et réaffiche un fil complet.
    const selectConversation = async (id: number) => {
      try {
        const res = await fetch(`${API_BASE}/conversations/${id}`, withCreds);
        if (res.status === 401) return void redirectToLogin();
        if (!res.ok) return;
        const detail = (await res.json()) as ConvDetail;
        currentConversationId = id;
        setUrl(id);
        list.innerHTML = "";
        for (const m of detail.messages) {
          const slot = addExchange(m.question);
          renderResult(m, slot);
        }
        renderConvList();
        closeSidebar();
        scrollDown();
        ta.focus();
      } catch {
        /* non bloquant */
      }
    };

    const startNewConversation = () => {
      currentConversationId = null;
      setUrl(null);
      list.innerHTML = "";
      renderConvList();
      closeSidebar();
      ta.focus();
    };

    // ───────────────────────────── Question en direct ───────────────────────

    const ask = async (q: string) => {
      const slot = addExchange(q);
      scrollDown();

      // Minuteur d'attente : démarre immédiatement, avant même la connexion SSE.
      const waiter = startWaiter(slot);

      // Le pipeline RAG prend des dizaines de secondes (3 appels LLM). On
      // consomme le flux Server-Sent Events de `/qa/stream` : les évènements
      // `stage` affichent la progression, `result` porte la réponse vérifiée.
      try {
        const res = await fetch(`${API_BASE}/qa/stream`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            question: q,
            conversationId: currentConversationId,
          }),
          ...withCreds,
        });
        if (res.status === 401) {
          waiter.stop();
          return void redirectToLogin();
        }
        if (res.status === 402) {
          waiter.stop();
          slot.innerHTML = noteHtml(
            "Vous avez atteint le quota offert du jour. La lecture du corpus et des textes reste libre, sans limite ; revenez demain pour de nouvelles questions offertes.",
          );
          scrollDown();
          return;
        }
        if (!res.ok || !res.body) {
          waiter.stop();
          slot.innerHTML = noteHtml(
            "Le service est momentanément indisponible. Réessaie dans un instant.",
          );
          scrollDown();
          return;
        }
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buf = "";
        let finished = false;
        while (!finished) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          const blocks = buf.split("\n\n");
          buf = blocks.pop() ?? "";
          for (const block of blocks) {
            const trimmed = block.trim();
            if (!trimmed || trimmed.startsWith(":")) continue; // ping / commentaire
            let event = "message";
            let data = "";
            for (const line of block.split("\n")) {
              if (line.startsWith("event:")) event = line.slice(6).trim();
              else if (line.startsWith("data:")) data += line.slice(5).trim();
            }
            if (event === "stage") {
              waiter.setLabel((JSON.parse(data) as { label: string }).label);
              scrollDown();
            } else if (event === "result") {
              waiter.stop();
              const payload = JSON.parse(data) as QaResponse;
              renderResult(payload, slot);
              onAnswered(q, payload);
              finished = true;
            } else if (event === "error") {
              waiter.stop();
              slot.innerHTML = noteHtml(
                (JSON.parse(data) as { detail: string }).detail,
              );
              finished = true;
            }
          }
        }
        // Filet de sécurité : flux clos sans évènement `result` (cf. `break`
        // sur `done`) — on arrête le minuteur dans tous les cas.
        waiter.stop();
      } catch {
        waiter.stop();
        slot.innerHTML = noteHtml(
          "La requête a échoué. Vérifie ta connexion et réessaie.",
        );
      }
      scrollDown();
    };

    // Met à jour l'état du fil après une réponse : un fil neuf est inséré en
    // tête de la liste latérale ; un fil existant remonte. L'URL suit.
    const onAnswered = (question: string, data: QaResponse) => {
      const id = data.conversationId;
      if (id == null) return;
      const wasNew = currentConversationId == null;
      currentConversationId = id;
      setUrl(id);
      const existing = conversations.find((c) => c.id === id);
      if (existing) {
        // Remonte le fil en tête (dernier actif).
        conversations = [existing, ...conversations.filter((c) => c.id !== id)];
      } else {
        const title =
          question.length > 80 ? question.slice(0, 79) + "…" : question;
        conversations = [
          { id, title, updatedAt: new Date().toISOString() },
          ...conversations,
        ];
      }
      if (wasNew) renderConvList();
    };

    // ───────────────────────────── Garde d'authentification ─────────────────

    const redirectToLogin = () => {
      window.location.href = "/login";
    };

    const requireAuth = async (): Promise<boolean> => {
      try {
        const res = await fetch(`${API_BASE}/auth/me`, withCreds);
        if (res.ok) return true;
      } catch {
        /* réseau : on traite comme non authentifié */
      }
      redirectToLogin();
      return false;
    };

    // ───────────────────────────── Câblage UI ───────────────────────────────

    document
      .getElementById("new-conv")
      ?.addEventListener("click", startNewConversation);
    document
      .getElementById("sidebar-open")
      ?.addEventListener("click", openSidebar);
    document
      .getElementById("sidebar-close")
      ?.addEventListener("click", closeSidebar);
    backdrop.addEventListener("click", closeSidebar);
    document.getElementById("logout")?.addEventListener("click", async () => {
      try {
        await fetch(`${API_BASE}/auth/logout`, { method: "POST", ...withCreds });
      } catch {
        /* on redirige quand même */
      }
      redirectToLogin();
    });

    ta.addEventListener("input", () => {
      autosize();
      btn.disabled = ta.value.trim().length < MIN_LEN;
    });

    ta.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const q = ta.value.trim();
      if (q.length < MIN_LEN) return;
      ta.value = "";
      autosize();
      btn.disabled = true;
      ta.focus();
      void ask(q);
    });

    // ───────────────────────────── Amorçage ─────────────────────────────────

    void (async () => {
      if (!(await requireAuth())) return;
      await loadConversations();

      const params = new URLSearchParams(window.location.search);
      const deepLink = Number(params.get("c"));
      if (deepLink && conversations.some((c) => c.id === deepLink)) {
        await selectConversation(deepLink);
      }

      const initialQ = params.get("q")?.trim();
      if (initialQ && initialQ.length >= MIN_LEN) {
        ta.value = initialQ;
        autosize();
        btn.disabled = false;
        form.requestSubmit();
      } else {
        ta.focus();
      }
    })();
  </script>
</BaseLayout>
